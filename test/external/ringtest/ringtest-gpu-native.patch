diff --git a/args.py b/args.py
index cec9c97..5b40cc8 100644
--- a/args.py
+++ b/args.py
@@ -85,12 +85,36 @@ parser.add_argument("-gpu",
                     help="Run CoreNEURON on GPU",
                     default=False)
 
+parser.add_argument("-gpu-native",
+                    dest='gpu_native',
+                    action='store_true',
+                    help="Run NEURON native GPU (gpu.backend=native)",
+                    default=False)
+
 parser.add_argument('-permute',
                     metavar='N',
                     help="permute option for cell topology (default 0)",
                     type=int,
                     default=0)
 
+parser.add_argument('-prcellstate_gid',
+                    metavar='N',
+                    help="prcellstate file written when non-negative gid (default -1)",
+                    type=int,
+                    default=-1)
+
+parser.add_argument('-prcellstate_checkpoint',
+                    metavar='STEP',
+                    help="phase prcellstate at step STEP for -prcellstate_gid (default -1)",
+                    type=int,
+                    default=-1)
+
+parser.add_argument('-prcellstate_checkpoint_t',
+                    metavar='T',
+                    type=float,
+                    default=-1.0,
+                    help="phase prcellstate at time T for -prcellstate_gid (overrides -prcellstate_checkpoint)")
+
 parser.add_argument("-show", action='store_true', help="show type topologies", default=False)
 
 parser.add_argument("-gap", action='store_true', help="use gap junctions", default=False)

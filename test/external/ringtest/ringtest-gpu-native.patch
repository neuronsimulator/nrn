@@ -221,12 +241,36 @@ def create_rings():
 
     return types, rings
 
+def prcs(gid):
+    if gid >= 0 and pc.gid_exists(gid):
+        suffix = "-cn" if use_coreneuron else ""
+        suffix += "-gpu" if coreneuron_gpu or use_native_gpu else ""
+        suffix += "-t%g" % (h.t,)
+        pc.prcellstate(gid, suffix)
+
+def arm_prcellstate_checkpoint():
+    if prcellstate_gid < 0:
+        return
+    if prcellstate_checkpoint_t >= 0:
+        pc.prcellstate_checkpoint(prcellstate_gid, 0, prcellstate_checkpoint_t)
+        if settings.rank == 0:
+            print("prcellstate checkpoint armed: gid=%d t=%g" %
+                  (prcellstate_gid, prcellstate_checkpoint_t))
+    elif prcellstate_checkpoint >= 0:
+        pc.prcellstate_checkpoint(prcellstate_gid, prcellstate_checkpoint)
+        if settings.rank == 0:
+            print("prcellstate checkpoint armed: gid=%d step=%d" %
+                  (prcellstate_gid, prcellstate_checkpoint))
+
 def runsim():
     ##  Run simulation ##
 
+    arm_prcellstate_checkpoint()
     runtime, load_balance, avg_comp_time, spk_time, gap_time = prun(tstop)
     timeit("run", settings.rank)
 
+    prcs(prcellstate_gid)
+
     ## Print stats ##
 
     pc.barrier()
